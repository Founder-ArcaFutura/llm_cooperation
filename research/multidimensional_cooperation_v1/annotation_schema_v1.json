{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional scenario-option construct annotation",
  "type": "object", "additionalProperties": false,
  "required": ["bank", "template_id", "scenario_id", "wording", "focal_option", "reference_option", "reviewer", "judgments"],
  "properties": {
    "bank": {"type": "string"}, "template_id": {"type": "string"}, "scenario_id": {"type": "string"},
    "wording": {"type": "string"}, "focal_option": {"type": "string"}, "reference_option": {"type": "string"}, "reviewer": {"type": "string"},
    "judgments": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["dimension", "label", "scope", "evidence_status", "source", "quote", "rationale", "confidence"],
      "properties": {
        "dimension": {"type": "string"}, "label": {"type": "string"}, "scope": {"type": "string", "description": "Party, outcome dimension, comparison, goal scope, and contribution, as applicable."},
        "evidence_status": {"enum": ["explicit", "inferred", "not_stated", "contradictory", "unresolved"]},
        "source": {"enum": ["stem", "target", "reference", "other_option", "author_metadata", "none"]},
        "quote": {"type": ["string", "null"]}, "rationale": {"type": "string"}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}
      }
    }}
  }
}
